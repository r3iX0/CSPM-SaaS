  "$comment": "Hand-maintained. build_catalog.py reads this beside the pinned Prowler install and writes apps/api/app/prowler/data/catalog.json. Edit this file and rerun the script; never edit the generated catalogue. See docs/DECISIONS.md section 150.",
  "prowler_version": "5.43.0",
  "providers": ["azure", "aws"],
  "directory_services": {
    "azure": ["entra"]
  },
  "exclude_severities": ["informational"],
  "exclude_categories": {
    "threat-detection": "Reads activity records (sign-ins, API calls, log contents) rather than configuration. Cleave assesses posture and does not ingest a customer's event stream."
  },
  "exclude_patterns": [
    {
      "pattern": "(no_secrets|find_secrets|secrets_user_data|document_secrets|no_environment_secrets)",
      "reason": "Scans the contents of code, environment variables, user data or logs for secrets. Cleave never reads secret material, so it neither asks for the permission nor stores what such a check would print."
    }
  ],
  "exclude": {
    "app_function_access_keys_configured": "Needs Microsoft.Web/sites/host/listkeys/action, which returns the function keys themselves. The scanner holds Reader and no list-keys action.",
    "network_public_ip_shodan": "Sends the customer's public IP addresses to Shodan, a third party, and needs an API key of its own.",
    "apim_threat_detection_llm_jacking": "Queries the customer's log contents rather than reading configuration.",
    "vm_desired_sku_size": "Judges against a list of approved sizes the customer has not given Cleave; with Prowler's empty default every machine fails.",
    "vm_ensure_using_approved_images": "Judges against a list of approved images the customer has not given Cleave; with Prowler's empty default every machine fails."
  },
