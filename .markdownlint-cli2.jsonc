// The Markdown standard as checks (docs/MARKDOWN_GUIDELINES.md, DECISIONS.md §192).
// Every rule markdownlint ships is on; the settings below choose a style where a
// rule offers several, and each one says why. Read by the pre-commit hook, CI
// and the VS Code extension alike.
{
  "config": {
    "default": true,

    // ATX headings (`## Title`), never underlined.
    "MD003": { "style": "atx" },
    // `-` bullets: `*` is easy to confuse with emphasis.
    "MD004": { "style": "dash" },
    // Nested bullets indent to the parent's text, which for `- ` is two spaces.
    "MD007": { "indent": 2 },
    // No trailing spaces at all, not even the two-space line break: it is
    // invisible and editors strip it. Use a new paragraph or a list instead.
    "MD009": { "br_spaces": 0, "strict": true },
    // 100 columns, the same as the code. Tables, code blocks and headings may
    // run over; a line that cannot break (a long URL) is allowed.
    "MD013": { "line_length": 100, "code_blocks": false, "tables": false, "headings": false },
    // A heading may repeat under different parents ("Why", "Tests").
    "MD024": { "siblings_only": true },
    // Either `1.` throughout or 1, 2, 3; never a mix within one list.
    "MD029": { "style": "one_or_ordered" },
    // A fence inside a list item may close straight into the next item.
    "MD031": { "list_items": false },
    // Markdown over HTML. These have no Markdown form: collapsible sections
    // (<details>, <summary>, with <b> because Markdown does not render inside
    // <summary>) and a line break inside a table cell (<br>).
    "MD033": { "allowed_elements": ["details", "summary", "b", "br"] },
    "MD035": { "style": "---" },
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    // `_italic_` and `**bold**`: different characters, so intent is visible
    // when both appear together.
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" },
    // Tables are kept as written; consistency within a table is enough.
    "MD060": false
  },

  "ignores": [
    "**/node_modules/**",
    "**/.venv/**",
    // Per-developer hookify rules: local, untracked, not ours to restyle.
    ".claude/*.local.md",
    "temp/**",
    // Generated by apps/api/scripts/generate_rule_catalog.py, with its own
    // drift check; its HTML anchors are deliberate.
    "docs/RULE_CATALOG.md",
    "docs/api/**",
    // Design handoff, kept as received.
    "docs/design_handoff_cleave_redesign/**"
  ]
}
