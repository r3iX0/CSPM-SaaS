{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/scanner.Dockerfile"
  },
  "deploy": {
    "startCommand": "celery -A cloudguard_scanner.celery_app.celery_app worker --queues=assess --loglevel=INFO --concurrency=2 --max-tasks-per-child=1",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
