---
/**
 * The cut mark and the name, as the product draws them (apps/web Brand.tsx):
 * one line, severed. The left half is the route in the text colour, the right
 * half what is left once the link is cut, in the brand.
 */
interface Props {
  animate?: boolean;
  class?: string;
}
const { animate = false, class: className = "" } = Astro.props;
---

<span class:list={["flex items-center gap-2", className]}>
  <svg
    viewBox="0 0 24 24"
    class="size-6 shrink-0"
    fill="none"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <line x1="1.5" y1="17" x2="9" y2="9.5" stroke="var(--fg)"></line>
    <line
      x1="15"
      y1="14.5"
      x2="22.5"
      y2="7"
      stroke="var(--brand)"
      class:list={[{ sever: animate }]}></line>
  </svg>
  <span class="text-[17px] font-semibold tracking-[-0.045em] lowercase">Cleave</span>
</span>
