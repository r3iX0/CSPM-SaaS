---
import Wordmark from "./Wordmark.astro";
import { NAV, APP_URL } from "../site";

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]"
  >
    <div class="max-w-xs">
      <Wordmark />
      <p class="mt-4 text-[15px] leading-relaxed text-muted">
        Cloud security posture for Azure, ranked by what an attacker can reach.
      </p>
    </div>
    <div>
      <h2 class="text-sm font-medium">Product</h2>
      <ul class="mt-3 text-[15px] text-muted">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="inline-block py-2.5 hover:text-fg">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-medium">Account</h2>
      <ul class="mt-3 text-[15px] text-muted">
        <li><a href={`${APP_URL}/sign-in`} class="inline-block py-2.5 hover:text-fg">Sign in</a></li>
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-4 pb-10 text-sm text-muted sm:px-6">
    © {year} Cleave
  </div>
</footer>
